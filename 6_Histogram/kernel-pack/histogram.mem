zeroBins {
    bins {
        MemConfig = "pfaces_rw_global";
        directionWriteOrRead = "false";
        HostDoWrite = "false";
        HostDoRead = "true";
        baseTypeSize = "4";
        baseTypeMultiple = "256";
        isRangeScalable = "false";
    }
}

histogramCompute {
    in_data {
        MemConfig = "pfaces_rw_global";
        directionWriteOrRead = "true";
        HostDoWrite = "true";
        HostDoRead = "false";
        baseTypeSize = "4";
        baseTypeMultiple = "1";
        isRangeScalable = "false";
    }
    bins {
        MemConfig = "pfaces_rw_global";
        directionWriteOrRead = "false";
        HostDoWrite = "false";
        HostDoRead = "true";
        baseTypeSize = "4";
        baseTypeMultiple = "256";
        isRangeScalable = "false";
        isNewOrResident = "false";
        residentArgRef = "zeroBins.bins";
    }
    local_bins {
        MemConfig = "pfaces_rw_global";
        isGlobalMemory = "false";
        isConstantMemory = "false";
        isLocalMemory = "true";
        directionWriteOrRead = "false";
        HostDoWrite = "false";
        HostDoRead = "false";
        baseTypeSize = "4";
        baseTypeMultiple = "256";
        isRangeScalable = "false";
    }
}
