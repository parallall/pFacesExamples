# function 0: exampleKernelFunction
exampleKernelFunction{ 

	# argument 0.0: data_in
	data_in{
		MemConfig           = "pfaces_rw_global";
		HostDoRead          = "true";
		baseTypeSize        = "1";
		baseTypeMultiple    = "4";
		isRangeScalable     = "false";
		isNewOrResident     = "true";
	}
}
